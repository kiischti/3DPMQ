{
  "name": "3dpmq",
  "version": "0.14.0",
  "description": "Self-hosted print request validation, approval and queue for makerspaces with PrusaLink printers",
  "license": "AGPL-3.0-or-later",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc --noEmit",
    "mock": "tsx mock/mock-prusalink.ts",
    "test": "node test/version.mjs && tsx test/bgcode.ts && tsx test/preview.ts && tsx test/classes-migration.ts && tsx test/run.ts"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
